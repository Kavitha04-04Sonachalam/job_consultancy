# Database configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/GlobalFly_db

# Security & Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# S3 / Cloudflare R2 Cloud Document Storage (Keep environment variable based)
STORAGE_BUCKET=GlobalFly-resumes
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key
STORAGE_SECRET_KEY=your_r2_or_s3_secret_key
STORAGE_REGION=auto
